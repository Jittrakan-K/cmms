rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function setupDoc() {
      return /databases/$(database)/documents/config/setup;
    }
    // สมาชิก = มีเอกสารใน users และสิทธิ์ไม่ใช่ disabled
    function isMember() {
      return request.auth != null && exists(userDoc())
        && get(userDoc()).data.role in ['admin', 'tech', 'operator'];
    }
    function role() {
      return get(userDoc()).data.role;
    }
    function isAdmin() {
      return isMember() && role() == 'admin';
    }
    // ผู้ดูแลเว็บ (ตำแหน่ง Admin Website) ลบบัญชีผู้อื่นได้
    function isWebAdmin() {
      return isAdmin() && get(userDoc()).data.get('position', '') == 'admin_web';
    }
    function loginDoc(empId) {
      return /databases/$(database)/documents/logins/$(empId);
    }
    function isTech() {
      return isMember() && role() in ['admin', 'tech'];
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function validStatus() {
      return request.resource.data.status in ['pending', 'open', 'doing', 'parts', 'done', 'cancelled']
        && (!('type' in request.resource.data) || request.resource.data.type in ['breakdown', 'pm', 'inspect', 'improve']);
    }
    // ปิดงานได้เมื่อมีรหัสสาเหตุและการแก้ไขที่ต้นเหตุ
    function closesProperly() {
      return request.resource.data.status != 'done'
        || (request.resource.data.cause is string && request.resource.data.cause.size() > 0
            && request.resource.data.action is string && request.resource.data.action.size() > 0);
    }
    // ยกเลิกใบงานต้องมีเหตุผล
    function cancelsProperly() {
      return request.resource.data.status != 'cancelled'
        || (request.resource.data.cancelReason is string && request.resource.data.cancelReason.size() > 0
            && request.resource.data.cancelledBy is string);
    }

    // role: admin = หัวหน้า อนุมัติและจัดการทุกอย่าง, tech = ช่าง ซ่อมและปิดงาน, operator = แจ้งซ่อมและดูข้อมูล
    function validRole() {
      return request.resource.data.role in ['admin', 'tech', 'operator', 'disabled'];
    }
    // ผู้ทำตั้งค่าครั้งแรก (ยังไม่มี config/setup แต่จะมีหลัง batch นี้ โดยตัวเองเป็นแอดมิน)
    function isFirstSetup() {
      return request.auth != null
        && !exists(setupDoc())
        && existsAfter(setupDoc())
        && getAfter(setupDoc()).data.adminUid == request.auth.uid;
    }

    // ตั้งค่าครั้งแรก: ใครก็อ่านได้ว่าตั้งค่าแล้วหรือยัง (มีแค่ชื่อโรงงาน)
    // สร้างได้ครั้งเดียว พร้อมกับเอกสารผู้ใช้แอดมินคนแรกใน batch เดียวกัน
    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null
        && !exists(setupDoc())
        && request.resource.data.adminUid == request.auth.uid
        && existsAfter(userDoc())
        && getAfter(userDoc()).data.role == 'admin';
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plant', 'dept']);
    }

    // สมาชิกอ่านรายชื่อได้ (ใช้เลือกผู้รับผิดชอบงาน) แอดมินเพิ่มและเปลี่ยนสิทธิ์
    // แอดมินลดสิทธิ์หรือลบบัญชีตัวเองไม่ได้ กันไม่ให้ระบบไม่มีแอดมินเหลือ
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isMember());
      allow create: if validRole() && (
        isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && !exists(setupDoc())
            && existsAfter(setupDoc())
            && getAfter(setupDoc()).data.adminUid == uid));
      allow update: if isAdmin() && validRole()
        && (uid != request.auth.uid || request.resource.data.role == 'admin');
      // เจ้าของบัญชีบอกว่าตั้งรหัสผ่านของตัวเองแล้ว (แก้ได้แค่ช่องนี้)
      allow update: if request.auth != null && request.auth.uid == uid
        && changedOnly(['mustChange']) && request.resource.data.mustChange == false;
      // ลบบัญชี: เฉพาะ Admin Website และลบบัญชีตัวเองไม่ได้
      // แอดมินคนอื่นลบได้เฉพาะตอนรีเซ็ตรหัสผ่าน (รหัสพนักงานถูกย้ายไปบัญชีใหม่ใน batch เดียวกัน)
      allow delete: if isAdmin() && uid != request.auth.uid && (
        isWebAdmin()
        || ('empId' in resource.data
            && existsAfter(loginDoc(resource.data.empId))
            && getAfter(loginDoc(resource.data.empId)).data.uid != uid));
    }

    // รหัสพนักงาน → อีเมลเบื้องหลังของ Firebase ใครก็อ่านทีละรหัสได้ (ใช้ตอนล็อกอิน) แต่ดึงรายชื่อทั้งหมดไม่ได้
    match /logins/{empId} {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && (isAdmin() || (isFirstSetup() && request.resource.data.uid == request.auth.uid));
      allow delete: if isWebAdmin();
    }

    match /assets/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /workOrders/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (request.resource.data.status == 'pending' || isTech())
        && validStatus()
        && (!('requestedUid' in request.resource.data) || request.resource.data.requestedUid in ['', request.auth.uid])
        && existsAfter(/databases/$(database)/documents/assets/$(request.resource.data.asset));
      // ช่างทำงานได้หลังหัวหน้าอนุมัติแล้วเท่านั้น และยกเลิกใบงานไม่ได้
      allow update: if isTech()
        && resource.data.status != 'pending'
        && resource.data.status != 'cancelled'
        && changedOnly(['status', 'endAt', 'tech', 'log', 'cause', 'action', 'partsUsed', 'checks', 'prNo', 'cost', 'costNote'])
        && request.resource.data.status != 'pending'
        && request.resource.data.status != 'cancelled'
        && validStatus() && closesProperly();
      // ผู้แจ้งยกเลิกใบงานของตัวเองได้ระหว่างรออนุมัติ
      allow update: if isMember()
        && resource.data.status == 'pending'
        && resource.data.get('requestedUid', '') == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && changedOnly(['status', 'endAt', 'log', 'cancelledBy', 'cancelReason'])
        && cancelsProperly();
      allow update: if isAdmin() && validStatus() && closesProperly() && cancelsProperly();
      allow delete: if isAdmin();
    }

    // ใบตรวจ TPM ตามเลขที่ WI: ทุกคนอ่านได้ แอดมินนำเข้าและแก้ไข
    match /checklists/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ผลตรวจ TPM: ผู้ใช้งานทุกตำแหน่งบันทึกได้ แก้ไขหรือลบได้เฉพาะแอดมิน
    match /inspections/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.by is string
        && request.resource.data.results is list
        && request.resource.data.results.size() <= 100;
      allow update, delete: if isAdmin();
    }

    // วันที่ตรวจล่าสุดของแต่ละจุดในเครื่อง (สรุปจาก inspections)
    match /tpmState/{asset} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['last', 'lastAt', 'lastBy', 'ng']);
      allow delete: if isAdmin();
    }

    // ประวัติรับเข้า/เบิกออกอะไหล่: ช่างและแอดมินบันทึก แก้ไขหรือลบได้เฉพาะแอดมิน
    match /stockMoves/{id} {
      allow read: if isMember();
      allow create: if isTech()
        && request.resource.data.dir in ['in', 'out']
        && request.resource.data.qty is number
        && request.resource.data.qty > 0;
      allow update, delete: if isAdmin();
    }

    match /pmPlans/{id} {
      allow read: if isMember();
      allow update: if isTech() && changedOnly(['dueDate', 'lastDone']);
      allow create, update, delete: if isAdmin();
    }

    match /parts/{id} {
      allow read: if isMember();
      allow update: if isTech() && changedOnly(['qty'])
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0;
      allow create, update, delete: if isAdmin();
    }

    // เครื่องมือวัด: ช่างบันทึกผลสอบเทียบได้ หัวหน้าจัดการทะเบียน
    match /gauges/{id} {
      allow read: if isMember();
      allow update: if isTech() && changedOnly(['status', 'lastCal', 'dueDate', 'note'])
        && request.resource.data.status in ['ok', 'hold'];
      allow create, update, delete: if isAdmin();
    }

    match /counters/workOrders {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.data.seq is int
        && (!exists(/databases/$(database)/documents/counters/workOrders)
            || request.resource.data.seq == resource.data.seq + 1
            || isAdmin());
    }
  }
}
